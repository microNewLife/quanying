/* pages/teacher/teacher.wxss */
.page-header {
  padding: 40rpx 30rpx;
  background-color: var(--primary-color);
  color: white;
  border-bottom-left-radius: var(--radius-lg);
  border-bottom-right-radius: var(--radius-lg);
  margin-bottom: 20rpx;
}

.page-header .title {
  font-size: 40rpx;
  font-weight: bold;
}

.page-header .subtitle {
  font-size: 26rpx;
  margin-top: 10rpx;
  opacity: 0.9;
}

/* ===== 筛选区域 ===== */
.filter-bar {
  padding: 0 20rpx 10rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  margin-bottom: 16rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
  height: 40rpx;
}

.search-placeholder {
  color: #aaa;
  font-size: 28rpx;
}

/* 标签横向滚动 */
.tag-scroll {
  width: 100%;
  white-space: nowrap;
}

.tag-list {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-bottom: 4rpx;
}

.tag-item {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-desc);
  background-color: #f0f0f0;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  margin-right: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.tag-active {
  color: var(--primary-color);
  background-color: rgba(242, 143, 59, 0.12);
  border-color: var(--primary-color);
  font-weight: 600;
}

/* 结果统计 */
.result-count {
  font-size: 22rpx;
  color: var(--text-desc);
  padding: 12rpx 30rpx 0;
}

/* ===== 卡片列表 ===== */
.teacher-list {
  padding: 10rpx 10rpx 40rpx;
}

.teacher-card {
  display: flex;
  flex-direction: column;
}

.teacher-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.cert-icon {
  font-size: 60rpx;
  margin-right: 24rpx;
  background-color: var(--secondary-color);
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
}

.info {
  flex: 1;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.qualification-tag {
  display: inline-block;
  font-size: 22rpx;
  color: var(--primary-dark);
  background-color: var(--secondary-color);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.cert-details {
  background-color: var(--bg-color);
  padding: 24rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 24rpx;
}

.detail-item {
  display: flex;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.detail-item:last-child {
  margin-bottom: 0;
}

.detail-item .label {
  color: var(--text-desc);
  width: 140rpx;
}

.detail-item .value {
  color: var(--text-main);
  font-weight: 500;
}

.actions {
  display: flex;
  justify-content: flex-end;
}

.btn-check {
  font-size: 26rpx;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
  padding: 10rpx 32rpx;
  border-radius: 30rpx;
}

.btn-check:active {
  background-color: rgba(242, 143, 59, 0.1);
}

.empty-state {
  text-align: center;
  padding: 80rpx;
  color: var(--text-light);
}
