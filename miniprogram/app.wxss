/* app.wxss */
page {
  /* 犬影村品牌主色调: 治愈橘黄系列 */
  --primary-color: #f28f3b;
  --primary-light: #ffb373;
  --primary-dark: #d4711d;

  /* 分级强调色与辅助色 */
  --secondary-color: #ffd166;
  --bg-color: #f9f9fb;
  --card-bg: #ffffff;

  /* 文本色 */
  --text-main: #2d3142;
  --text-desc: #9094a6;
  --text-light: #c0c4d6;

  /* 扁平化极简边框与圆角设置 */
  --border-color: #f0f2f5;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;

  /* 覆盖全页面底色 */
  background-color: var(--bg-color);
  font-family:
    -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial,
    sans-serif;
  color: var(--text-main);
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 扁平化卡片核心样式复用 */
.flat-card {
  background-color: var(--card-bg);
  border-radius: var(--radius-md);
  padding: 30rpx;
  margin: 20rpx;
  /* 强调扁平化设计，移除任何 boxShadow，仅保留 1px 无感边框 */
  border: 1rpx solid var(--border-color);
}

/* 主色调扁平按钮 */
.btn-primary {
  background-color: var(--primary-color);
  color: #ffffff;
  border-radius: var(--radius-md);
  font-weight: 500;
  font-size: 32rpx;
  text-align: center;
  padding: 24rpx 0;
  width: 100%;
  border: none;
}
.btn-primary:active {
  background-color: var(--primary-dark);
}

/* 全白背景辅助容器 */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Flex 工具类 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.flex-col {
  display: flex;
  flex-direction: column;
}
.justify-between {
  justify-content: space-between;
}
.justify-center {
  justify-content: center;
}
