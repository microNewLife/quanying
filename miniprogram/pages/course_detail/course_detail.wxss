/* pages/course_detail/course_detail.wxss */
page {
  background-color: #f7f8fa;
  padding-bottom: 200rpx; /* 为浮动按钮留白 */
}

.container {
  display: flex;
  flex-direction: column;
}

/* 封面图样式 */
.course-cover {
  width: 100%;
  height: 500rpx;
  background-color: #eee;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

/* 内容区域包裹 */
.content-wrapper {
  margin-top: -40rpx; /* 向上偏移产生交替层叠感 */
  padding: 40rpx;
  background-color: #fff;
  border-radius: 40rpx 40rpx 0 0;
  position: relative;
  z-index: 2;
}

/* 详情头部 */
.course-header {
  display: flex;
  flex-direction: column;
  margin-bottom: 30rpx;
}

.course-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.tag-row {
  display: flex;
}

.tag-hot {
  font-size: 24rpx;
  color: #F28F3B;
  background-color: rgba(242, 143, 59, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.divider {
  width: 100%;
  height: 2rpx;
  background: #f0f0f0;
  margin: 30rpx 0;
}

/* 课程介绍区 */
.section {
  margin-top: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  border-left: 8rpx solid #F28F3B;
  padding-left: 20rpx;
}

.course-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap; /* 保持后台文本换行 */
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 600rpx;
  color: #999;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #F28F3B;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 底部悬浮栏 */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 140rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -10rpx 40rpx rgba(0,0,0,0.05);
  z-index: 10;
}

.btn-home {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
  flex-shrink: 0;
}

.icon-home {
  font-size: 40rpx;
}

.btn-home text {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
}

.btn-primary {
  flex: 1;
  background: linear-gradient(90deg, #F28F3B, #FFB347);
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(242, 143, 59, 0.3);
}

.btn-primary.disabled {
  background: #ccc;
  box-shadow: none;
}
